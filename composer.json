{
    "name": "nicxonsolutions/laravel-shopping-cart",
    "description": "Laravel 5, 6, 7, 8, 9, 10, 11, 12 & 13 Shopping cart",
    "version": "1.0.2",
    "keywords": [
        "laravel",
        "shopping cart",
        "cart",
        "laravel 5",
        "laravel 6",
        "laravel 7",
        "laravel 8",
        "laravel 9",
        "laravel 10",
        "laravel 11",
        "laravel 12",
        "laravel 13",
        "nicxonsolutions",
        "robertnicjoo"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Nicxon Solutions",
            "email": "dev@nicxonsolutions.com",
            "homepage": "https://nicxonsolutions.com"
        },
        {
            "name": "Robert Nicjoo",
            "homepage": "https://github.com/robertnicjoo"
        }
    ],
    "homepage": "https://github.com/robertnicjoo/laravel-shopping-cart",
    "support": {
        "issues": "https://github.com/robertnicjoo/laravel-shopping-cart/issues",
        "source": "https://github.com/robertnicjoo/laravel-shopping-cart"
    },
    "require": {
        "php": ">=7.3",
        "illuminate/support": "5.0.*|5.1.*|5.2.*|5.3.*|5.4.*|5.5.*|5.6.*|5.7.*|5.8.*|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "5.0.*|5.1.*|5.2.*|5.3.*|5.4.*|5.5.*|5.6.*|5.7.*|5.8.*|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/translation": "5.0.*|5.1.*|5.2.*|5.3.*|5.4.*|5.5.*|5.6.*|5.7.*|5.8.*|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.4.2",
        "phpunit/phpunit": "^9.0",
        "symfony/var-dumper": "5.1.5.*@dev|^7.4"
    },
    "autoload": {
        "psr-4": {
            "Nicxonsolutions\\": "src/Nicxonsolutions"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nicxonsolutions\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "extra": {
        "laravel": {
            "providers": [
                "Nicxonsolutions\\Cart\\CartServiceProvider"
            ],
            "aliases": {
                "Cart": "Nicxonsolutions\\Cart\\Facades\\CartFacade"
            }
        }
    }
}